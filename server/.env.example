# ==========================================
# GENESIS ENGINE - Environment Configuration
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ==========================================
# SECURITY (REQUIRED)
# ==========================================

# JWT Secret - Change this to a strong random string in production!
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars

# ==========================================
# AI PROVIDER API KEYS
# ==========================================

# HuggingFace (FREE - Required minimum)
# Get your token at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=your_huggingface_token_here

# Replicate (FREE tier available)
# Get your token at: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=your_replicate_token_here

# Stability AI (Paid - Optional)
# Get your key at: https://platform.stability.ai/
STABILITY_API_KEY=your_stability_key_here

# OpenAI (Paid - Optional)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_key_here

# ==========================================
# OPTIONAL FEATURES
# ==========================================

# WebSocket Configuration
WS_PORT=5001
WS_CORS_ORIGIN=http://localhost:5173

# Rate Limiting (20 free generations/day is default)
DAILY_GENERATION_LIMIT=20
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# File Upload Configuration
MAX_FILE_SIZE=52428800
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs

# ==========================================
# MONITORING & LOGGING (Production)
# ==========================================

# Log Level: debug, info, warn, error
LOG_LEVEL=info

# Sentry (Error Tracking - Optional)
SENTRY_DSN=your_sentry_dsn_here

# Analytics (Optional)
ANALYTICS_ENABLED=false
ANALYTICS_KEY=your_analytics_key_here

# ==========================================
# DATABASE (Production)
# ==========================================

# For production, switch from in-memory to PostgreSQL
# DATABASE_URL=postgresql://user:password@localhost:5432/genesis_engine

# Redis (for production queue management)
# REDIS_URL=redis://localhost:6379

# ==========================================
# CLOUD STORAGE (Production)
# ==========================================

# AWS S3 / CloudFlare R2 (for production image storage)
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_BUCKET_NAME=genesis-engine-uploads
# AWS_REGION=us-east-1
# AWS_ENDPOINT=https://your-endpoint.r2.cloudflarestorage.com

# ==========================================
# EMAIL (Production)
# ==========================================

# For password reset, notifications
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# EMAIL_FROM=noreply@genesis-engine.com

# ==========================================
# PAYMENTS (For Pro tier - Optional)
# ==========================================

# Stripe (for paid subscriptions)
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ==========================================
# DEVELOPMENT ONLY
# ==========================================

# Debug Mode
debug=false

# Hot Reload
HOT_RELOAD=true

# Mock API Responses (for testing without API keys)
MOCK_API=false

# ==========================================
# NOTES
# ==========================================
# 
# 1. NEVER commit the actual .env file to Git!
# 2. Copy this file to .env and fill in your values
# 3. For production, use strong secrets and proper database
# 4. At minimum, you need HUGGINGFACE_API_KEY for free generations
# 5. The daily limit of 20 free generations resets at midnight UTC
#
# Quick Start:
# 1. cp .env.example .env
# 2. Add your HUGGINGFACE_API_KEY
# 3. npm start
#
