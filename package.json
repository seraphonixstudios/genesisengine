{
  "name": "ai-image-generator-pro",
  "version": "2.0.0",
  "description": "Advanced AI Image Generator with multiple providers, upscaling, editing, and enhanced UI",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "server": "node server/server.js",
    "server:legacy": "node server.js",
    "client": "cd client && npm start",
    "client:dev": "cd client && npm run dev",
    "dev:full": "concurrently \"npm run server\" \"npm run client\"",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "setup": "node scripts/setup.js",
    "download:models": "node scripts/download-models.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e:api": "jest tests/e2e/system.test.ts",
    "test:integration": "jest tests/integration/api.test.ts",
    "test:e2e:frontend": "playwright test",
    "test:e2e:frontend:headed": "playwright test --headed",
    "test:e2e:frontend:debug": "playwright test --debug",
    "test:all": "npm run test:e2e:api && npm run test:integration && npm run test:e2e:frontend",
    "test:ci": "npm run test:coverage && npm run test:e2e:api && npm run test:integration"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "axios": "^1.14.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.10.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1",
    "node-fetch": "^3.3.2",
    "sharp": "^0.33.2",
    "socket.io": "^4.7.2",
    "uuid": "^14.0.0",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.0",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^9.0.8",
    "concurrently": "^9.2.1",
    "jest": "^29.7.0",
    "prisma": "^5.10.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
