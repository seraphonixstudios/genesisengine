# Development Environment Configuration

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_image_generator
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Application
NODE_ENV=development
APP_PORT=5000
PORT=5000
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# JWT Secrets (CHANGE IN PRODUCTION!)
JWT_SECRET=your-jwt-secret-change-me-in-production
JWT_REFRESH_SECRET=your-refresh-secret-change-me-in-production

# Image Generation Providers
POLLINATIONS_ENABLED=true

# Optional: Hugging Face (free tier available)
HUGGINGFACE_API_KEY=
HUGGINGFACE_IMAGE_MODEL=stabilityai/stable-diffusion-xl-base-1.0

# Optional: Together AI (free tier available)
TOGETHER_API_KEY=
TOGETHER_IMAGE_MODEL=

# Optional: OpenAI DALL-E (paid)
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=dall-e-3

# Provider fallback
ENABLE_PROVIDER_FALLBACK=true

# Admin Interface
ADMINER_PORT=8080
